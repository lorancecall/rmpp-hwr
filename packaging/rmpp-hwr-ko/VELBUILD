# Model files only: rmpp-hwr lists every /home/root/.vellum/share/rmpp-hwr-*/pack.json as a model (not deletable
# in its UI: `vellum del $pkgname`). Read at run time, so no xochitl restart and no root file system change.
# Training data, attributions and license: MODEL_CARD.md; base model: rmpp-hwr's NOTICE.

package() {
	install -Dm644 "$srcdir"/rec.onnx "$pkgdir"/home/root/.vellum/share/$pkgname/rec.onnx
	install -Dm644 "$srcdir"/dict.txt "$pkgdir"/home/root/.vellum/share/$pkgname/dict.txt
	install -Dm644 "$srcdir"/model.txt "$pkgdir"/home/root/.vellum/share/$pkgname/model.txt
	install -Dm644 "$srcdir"/pack.json "$pkgdir"/home/root/.vellum/share/$pkgname/pack.json
	install -Dm644 "$srcdir"/MODEL_CARD.md "$pkgdir"/home/root/.vellum/licenses/$pkgname/MODEL_CARD.md
}
