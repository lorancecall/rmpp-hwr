# Each lifecycle function runs as its own script: no shared helpers, every step is written out.
# Never `systemctl stop xochitl`: that powers the tablet off. Scripts never restart xochitl themselves: they re-arm
# the transient timer rmpp-restart-xochitl (15 s, runs /usr/lib/rmpp/restart), so a transaction restarts it once.
# Root file system: the UI library goes to /usr/lib/rmpp/rmpp-hwr with a link in preload.d (60); a library xochitl
# may have loaded is renamed to *.old or moved to /usr/lib/rmpp/.trash, never deleted. Plain
# `mount -o remount,rw|ro /`: Vellum's mount-rw drops /etc/dropbear.
# Engine, onnxruntime and practice texts stay in /home/root/.vellum/share/rmpp-hwr (the UI looks there first, then
# in /home/root/.local/share/rmpp-hwr for `hwr install` copies). User data in /home/root/.local/share/rmpp-hwr
# (records, practice, user models) is never touched, except the program copies an older release install left there.

package() {
	install -Dm755 "$srcdir"/librmpp-hwr-ui.so "$pkgdir"/home/root/.vellum/share/rmpp-hwr/librmpp-hwr-ui.so
	install -Dm755 "$srcdir"/librmpp_hwr.so "$pkgdir"/home/root/.vellum/share/rmpp-hwr/librmpp_hwr.so
	install -Dm755 "$srcdir"/libonnxruntime.so "$pkgdir"/home/root/.vellum/share/rmpp-hwr/libonnxruntime.so
	mkdir -p "$pkgdir"/home/root/.vellum/share/rmpp-hwr/texts
	tar -xf "$srcdir"/texts.tar -C "$pkgdir"/home/root/.vellum/share/rmpp-hwr/texts
	install -Dm644 "$srcdir"/LICENSE "$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	install -Dm644 "$srcdir"/NOTICE "$pkgdir"/home/root/.vellum/licenses/$pkgname/NOTICE
	echo "https://github.com/$upstream_author/rmpp-hwr" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	# a release install (rmpp-install.sh) left program copies in the data folder: the package's copies win anyway,
	# so drop the engine and onnxruntime (~26 MB) and the old glyphs; models and user data stay
	rm -f /home/root/.local/share/rmpp-hwr/librmpp_hwr.so /home/root/.local/share/rmpp-hwr/libonnxruntime.so /home/root/.local/share/rmpp-hwr/glyphs.json
	mount -o remount,rw /
	mkdir -p /usr/lib/rmpp/rmpp-hwr /usr/lib/rmpp/preload.d
	cp /home/root/.vellum/share/rmpp-hwr/librmpp-hwr-ui.so /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so.new && chmod 755 /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so.new && { [ ! -e /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so ] || mv -f /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so.old; } && mv -f /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so.new /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so
	ln -sfn ../rmpp-hwr/librmpp-hwr-ui.so /usr/lib/rmpp/preload.d/60-rmpp-hwr.so
	# older release installs: /usr/lib/rmpp-hwr + /usr/lib/rmpp-preload.d link (deleted after the restart)
	if [ -e /usr/lib/rmpp-hwr ] || [ -L /usr/lib/rmpp-preload.d/60-rmpp-hwr.so ]; then
		mkdir -p /usr/lib/rmpp/.trash
		rm -f /usr/lib/rmpp-preload.d/60-rmpp-hwr.so
		[ ! -e /usr/lib/rmpp-hwr ] || mv /usr/lib/rmpp-hwr /usr/lib/rmpp/.trash/usr_lib_rmpp-hwr.$$
	fi
	sync
	mount -o remount,ro / || echo "note: / stays read-write until xochitl restarts"
	# one xochitl restart per Vellum transaction: (re)arm the timer, so the last package script wins
	systemctl stop rmpp-restart-xochitl.timer 2>/dev/null || true
	systemd-run --quiet --unit=rmpp-restart-xochitl --on-active=15 --timer-property=AccuracySec=1s \
		/bin/sh -c '[ -x /usr/lib/rmpp/restart ] && exec /usr/lib/rmpp/restart; systemctl reset-failed xochitl; systemctl restart xochitl' || \
		{ systemctl reset-failed xochitl 2>/dev/null || true; systemctl restart xochitl; }
}

postupgrade() {
	mount -o remount,rw /
	mkdir -p /usr/lib/rmpp/rmpp-hwr /usr/lib/rmpp/preload.d
	cp /home/root/.vellum/share/rmpp-hwr/librmpp-hwr-ui.so /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so.new && chmod 755 /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so.new && { [ ! -e /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so ] || mv -f /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so.old; } && mv -f /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so.new /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so
	ln -sfn ../rmpp-hwr/librmpp-hwr-ui.so /usr/lib/rmpp/preload.d/60-rmpp-hwr.so
	sync
	mount -o remount,ro / || echo "note: / stays read-write until xochitl restarts"
	# one xochitl restart per Vellum transaction: (re)arm the timer, so the last package script wins
	systemctl stop rmpp-restart-xochitl.timer 2>/dev/null || true
	systemd-run --quiet --unit=rmpp-restart-xochitl --on-active=15 --timer-property=AccuracySec=1s \
		/bin/sh -c '[ -x /usr/lib/rmpp/restart ] && exec /usr/lib/rmpp/restart; systemctl reset-failed xochitl; systemctl restart xochitl' || \
		{ systemctl reset-failed xochitl 2>/dev/null || true; systemctl restart xochitl; }
}

# `vellum reenable` after an OS update: the root file system is already writable here; rmpp-preload's
# postosupgrade restarts xochitl.
postosupgrade() {
	mkdir -p /usr/lib/rmpp/rmpp-hwr /usr/lib/rmpp/preload.d
	cp /home/root/.vellum/share/rmpp-hwr/librmpp-hwr-ui.so /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so.new && chmod 755 /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so.new && { [ ! -e /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so ] || mv -f /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so.old; } && mv -f /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so.new /usr/lib/rmpp/rmpp-hwr/librmpp-hwr-ui.so
	ln -sfn ../rmpp-hwr/librmpp-hwr-ui.so /usr/lib/rmpp/preload.d/60-rmpp-hwr.so
	sync
}

predeinstall() {
	mount -o remount,rw /
	mkdir -p /usr/lib/rmpp/.trash
	rm -f /usr/lib/rmpp/preload.d/60-rmpp-hwr.so
	[ ! -e /usr/lib/rmpp/rmpp-hwr ] || mv /usr/lib/rmpp/rmpp-hwr /usr/lib/rmpp/.trash/rmpp-hwr.$$
	sync
	mount -o remount,ro / || echo "note: / stays read-write until xochitl restarts"
	# one xochitl restart per Vellum transaction: (re)arm the timer, so the last package script wins
	systemctl stop rmpp-restart-xochitl.timer 2>/dev/null || true
	systemd-run --quiet --unit=rmpp-restart-xochitl --on-active=15 --timer-property=AccuracySec=1s \
		/bin/sh -c '[ -x /usr/lib/rmpp/restart ] && exec /usr/lib/rmpp/restart; systemctl reset-failed xochitl; systemctl restart xochitl' || \
		{ systemctl reset-failed xochitl 2>/dev/null || true; systemctl restart xochitl; }
	# `vellum purge` (rmpp setup: "Also delete their settings and data"): settings and data in /home too
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/.config/rmpp-hwr /home/root/.local/share/rmpp-hwr
	fi
}
