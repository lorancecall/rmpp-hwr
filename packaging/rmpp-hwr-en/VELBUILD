# Model files only: rmpp-hwr lists every /home/root/.vellum/share/rmpp-hwr-*/pack.json as a model (not deletable
# in its UI: `vellum del $pkgname`). Read at run time, so no xochitl restart and no root file system change.
# Attributions: rmpp-hwr's NOTICE (/home/root/.vellum/licenses/rmpp-hwr/NOTICE)

package() {
	mkdir -p "$pkgdir"/home/root/.vellum/share/$pkgname
	cp -r "$srcdir"/rmpp-hwr-english-base/. "$pkgdir"/home/root/.vellum/share/$pkgname/
}
