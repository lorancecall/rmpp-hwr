# rmpp-hwr local configuration. Copy to .env (never committed) and fill in.
# Every value can also be set as an environment variable, which wins over .env.

# ---------- tablet ----------
RMPP_HOST=rmpp                      # ssh alias of the tablet (~/.ssh/config)
RMPP_IP=                            # tablet IP, used by `hwr pull` (direct ssh with RMPP_KEY)
RMPP_KEY=~/.ssh/id_ed25519_rmpp     # ssh key for RMPP_IP

# ---------- evaluation ----------
HWR_EVAL_DOC=                       # xochitl id of the practice notebook whose first HWR_EVAL_N lines are never trained on
HWR_EVAL_N=12

# ---------- where training runs ----------
# local = this computer's GPU, slurm = a cluster reached over ssh (jobs go through sbatch)
HWR_BACKEND=local

# Mixed precision for training. bfloat16 needs an Ampere or newer GPU (A100, L40, RTX 30xx/40xx);
# older GPUs (RTX 20xx, V100) use float16 or no AMP.
HWR_AMP=0
HWR_AMP_DTYPE=float16
HWR_AMP_LEVEL=O1

# ---------- local backend ----------
HWR_LOCAL_WORK=                     # work dir for data, checkpoints, exports (needs ~30 GB), e.g. D:/hwr-work
HWR_LOCAL_SETUP=                    # shell run before each job (bash), e.g. source ~/miniconda3/etc/profile.d/conda.sh && conda activate hwr
HWR_LOCAL_GPU=0                     # CUDA_VISIBLE_DEVICES

# ---------- slurm backend ----------
HWR_SLURM_HOST=                     # ssh alias of the login node
HWR_SLURM_WORK=                     # work dir on the cluster file system
HWR_SLURM_SETUP=                    # shell run at the start of each job, e.g. module load ... && conda activate <env>
HWR_SLURM_ACCOUNT=                  # optional: -A
HWR_SLURM_GPU_PARTITION=            # partition for training/export (-p)
HWR_SLURM_GPU_QOS=                  # optional: --qos for the GPU partition
HWR_SLURM_GPU_GRES=gpu:1            # --gres
HWR_SLURM_CPU_PARTITION=            # partition for data generation and evaluation
HWR_SLURM_CPU_QOS=                  # optional

# ---------- open dataset ----------
HWR_DB_REPO=lorancecall/rmpp-hwr-db # GitHub repo that `hwr contribute` sends pages to
